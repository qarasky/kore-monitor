# /etc/koremonitor-backup.env (mode 0600, root) — read by koremonitor-backup.service.
# Every line is optional; the defaults assume compose.yaml runs from /opt/koremonitor.
# The database variable also answers to its pre-rename name, FLATLINE_DB.

#KOREMONITOR_DB=/opt/koremonitor/data/flatline.db
#BACKUP_DIR=/opt/koremonitor/backups/nightly
#KEEP_DAILY=14
#KEEP_WEEKLY=8
# ISO weekday kept as the weekly copy (7 = Sunday).
#WEEKLY_DAY=7

# Off-host copy, skipped while empty. The backup directory is mirrored
# (deletions included, so the remote follows the rotation).
#   rsync over ssh (root's key must be authorised on the target):
#OFFSITE_TOOL=rsync
#OFFSITE_TARGET=backup@nas.example:/srv/backups/koremonitor
#   rclone (remote configured in /root/.config/rclone/rclone.conf):
#OFFSITE_TOOL=rclone
#OFFSITE_TARGET=b2:koremonitor-backups

# Fetched after a successful run; alert when it stops arriving.
#NOTIFY_URL=https://hc-ping.com/<uuid>
